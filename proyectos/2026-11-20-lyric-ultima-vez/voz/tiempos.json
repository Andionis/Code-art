{
  "firma": "cancion",
  "duracion": 41.8,
  "frases": [
    {
      "n": 1,
      "texto": "Por fuera estoy riendo y por dentro me estoy muriendo",
      "clave": "muriendo",
      "inicio": 0.4,
      "fin": 2.58
    },
    {
      "n": 2,
      "texto": "Estoy agonizando; baby, yo te extraño",
      "clave": "agonizando",
      "inicio": 2.6,
      "fin": 6.88
    },
    {
      "n": 3,
      "texto": "Ya tú no me habla' y yo no sé qué hacer",
      "clave": "habla",
      "inicio": 7.52,
      "fin": 11.22
    },
    {
      "n": 4,
      "texto": "Mi conciencia me dice que tú no' va' a volver",
      "clave": "conciencia",
      "inicio": 12.34,
      "fin": 16.04
    },
    {
      "n": 5,
      "texto": "Yo nunca te quería perder, baby, yo me enredé en tu piel",
      "clave": "perder",
      "inicio": 17.44,
      "fin": 22.38
    },
    {
      "n": 6,
      "texto": "Yo solo te quiero comer tu totito otra vez",
      "clave": "comer",
      "inicio": 22.44,
      "fin": 27.32
    },
    {
      "n": 7,
      "texto": "Y si tú crees, que yo, no sé amar",
      "clave": "amar",
      "inicio": 27.4,
      "fin": 32.02
    },
    {
      "n": 8,
      "texto": "Pues yo te olvido y tú olvídame",
      "clave": "olvido",
      "inicio": 32.26,
      "fin": 35.66
    },
    {
      "n": 9,
      "texto": "Pero si tú, na' más, quieres chingar",
      "clave": "chingar",
      "inicio": 37.28,
      "fin": 41.8
    }
  ],
