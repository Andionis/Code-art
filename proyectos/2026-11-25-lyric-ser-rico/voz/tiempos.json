{
  "firma": "cancion",
  "duracion": 27.74,
  "frases": [
    {
      "n": 1,
      "texto": "Ser rico e' otra cosa, te lo juro, otra cosa",
      "clave": "rico",
      "inicio": 1,
      "fin": 4.12
    },
    {
      "n": 2,
      "texto": "Yo pensaba en to' esto cuando yo estaba en el lodo",
      "clave": "lodo",
      "inicio": 4.8,
      "fin": 7.26
    },
    {
      "n": 3,
      "texto": "Mira cómo el tiempo pasa",
      "clave": "tiempo",
      "inicio": 7.8,
      "fin": 9.28
    },
    {
      "n": 4,
      "texto": "Del que tú te burla' corona, al que tú humilla' progresa",
      "clave": "corona",
      "inicio": 10.64,
      "fin": 14.78
    },
    {
      "n": 5,
      "texto": "Yo era uno de eso', 'taba en la pobreza, y yo no me iba a quedar con esa",
      "clave": "pobreza",
      "inicio": 15.7,
      "fin": 20
    },
    {
      "n": 6,
      "texto": "Gracia' a papá Dio' que el mundo da pila 'e vuelta",
      "clave": "gracia",
      "inicio": 22,
      "fin": 24.4
    },
    {
      "n": 7,
      "texto": "Yo hice pila 'e vuelta pa' que se dé la vuelta",
      "clave": "vuelta",
      "inicio": 24.667,
      "fin": 27.54
    }
  ],
