 "frases": [
  {
   "n": 1,
   "texto": "Certero",
   "clave": "certero",
   "inicio": 0.52,
   "fin": 1.54
  },
  {
   "n": 2,
   "texto": "Pa' morirme yo te cazo primero",
   "clave": "morirme",
   "inicio": 1.9,
   "fin": 4.28
  },
  {
   "n": 3,
   "texto": "Con la DEA yo no coopero",
   "clave": "dea",
   "inicio": 4.96,
   "fin": 6.64
  },
  {
   "n": 4,
   "texto": "No traiciono por puta' ni dinero",
   "clave": "traiciono",
   "inicio": 7.34,
   "fin": 9.74
  },
  {
   "n": 5,
   "texto": "Guerrero, escare'",
   "clave": "guerrero",
   "inicio": 10.12,
   "fin": 12.42
  },
  {
   "n": 6,
   "texto": "Mis brazos armado' disfrazado' de militare'",
   "clave": "armado",
   "inicio": 12.66,
   "fin": 15.18
  },
  {
   "n": 7,
   "texto": "Brr",
   "clave": "brr",
   "inicio": 15.2,
   "fin": 15.5
  },
  {
   "n": 8,
   "texto": "Fenta y perico cruzando los mare'",
   "clave": "fenta",
   "inicio": 15.54,
   "fin": 17.788
  },
  {
   "n": 9,
   "texto": "Mucho dinero, nivel 10 los blindaje'",
   "clave": "dinero",
   "inicio": 18.12,
   "fin": 20.6
  },
  {
   "n": 10,
   "texto": "No se resbalen",
   "clave": "resbalen",
   "inicio": 20.84,
   "fin": 22.05
  },
  {
   "n": 11,
   "texto": "Brr",
   "clave": "brr",
   "inicio": 22.1,
   "fin": 22.6
  },
  {
   "n": 12,
   "texto": "El avión lleno de kilo' aterrizó",
   "clave": "avion",
   "inicio": 23.82,
   "fin": 25.78
  },
  {
   "n": 13,
   "texto": "Tu puta conmigo se mojó",
   "clave": "mojo",
   "inicio": 26.84,
   "fin": 28.28
  },
  {
   "n": 14,
   "texto": "No sé cuánto tomó, se emborrachó",
   "clave": "emborracho",
   "inicio": 29.4,
   "fin": 31.22
  },
  {
   "n": 15,
   "texto": "Se tocó el totito con mi Glock",
   "clave": "totito",
   "inicio": 32.28,
   "fin": 33.962
  },
  {
   "n": 16,
   "texto": "Con mi Glock, con mi Glock",
   "clave": "glock",
   "inicio": 33.96,
   "fin": 35.3
  }
 ],
