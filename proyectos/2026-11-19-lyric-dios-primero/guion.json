{
  "titulo": "Dios Primero (lyric)",
  "idioma": "es",
  "subtitulos": "no",
  "frases": [
    {
      "texto": "Despué' que tú te busca es que te buscan",
      "clave": "buscan"
    },
    {
      "texto": "Tuve que guaya' la yuca, yo no me detuve nunca",
      "clave": "nunca"
    },
    {
      "texto": "Yo sé que vamo' a morir, todito'",
      "clave": "morir"
    },
    {
      "texto": "pero ante' de morirme quiero como cuatro casa",
      "clave": "casa"
    },
    {
      "texto": "Yo estoy en una nota",
      "clave": "nota"
    },
    {
      "texto": "De hacer dinero porque lo malo atrasa",
      "clave": "dinero"
    },
    {
      "texto": "Yo siempre le dije a mami, que yo me iba a buscar",
      "clave": "mami"
    },
    {
      "texto": "debería estar orgullosa",
      "clave": "orgullosa"
    },
    {
      "texto": "Gracia', Dios mío",
      "clave": "dios"
    }
  ]
}