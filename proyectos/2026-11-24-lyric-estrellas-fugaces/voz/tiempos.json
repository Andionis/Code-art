{
  "firma": "cancion",
  "duracion": 22,
  "frases": [
    {
      "n": 1,
      "texto": "Tú y yo somos como estrellas fugaces",
      "clave": "estrellas",
      "inicio": 0.94,
      "fin": 3.22
    },
    {
      "n": 2,
      "texto": "Cosas que todos ven, pero no entienden",
      "clave": "entienden",
      "inicio": 3.7,
      "fin": 5.8
    },
    {
      "n": 3,
      "texto": "Nacimos pa' estar juntos hasta la muerte",
      "clave": "juntos",
      "inicio": 6.4,
      "fin": 8.5
    },
    {
      "n": 4,
      "texto": "Yo siempre te siento, dime si me sientes",
      "clave": "siento",
      "inicio": 8.56,
      "fin": 11.26
    },
    {
      "n": 5,
      "texto": "Muchas veces yo intenté olvidarte",
      "clave": "olvidarte",
      "inicio": 11.96,
      "fin": 13.88
    },
    {
      "n": 6,
      "texto": "Pero no te saco nunca de mi mente",
      "clave": "mente",
      "inicio": 14.06,
      "fin": 16.8
    },
    {
      "n": 7,
      "texto": "Contigo yo vo'a seguir la corriente",
      "clave": "corriente",
      "inicio": 17.3,
      "fin": 19.3
    },
    {
      "n": 8,
      "texto": "El destino no miente",
      "clave": "destino",
      "inicio": 19.5,
      "fin": 21.02
    },
    {
      "n": 9,
      "texto": "Y quiero",
      "clave": "quiero",
      "inicio": 21.08,
      "fin": 21.82
    }
  ],
