{
  "firma": "cancion",
  "duracion": 37.15,
  "frases": [
    {
      "n": 1,
      "texto": "Quieren matarme, ya están haciendo reunione'",
      "clave": "matarme",
      "inicio": 0.2,
      "fin": 2.349
    },
    {
      "n": 2,
      "texto": "Bajen las blindada' y a los diablo' con cuerno' y cincuentone'",
      "clave": "blindada",
      "inicio": 2.66,
      "fin": 5.702
    },
    {
      "n": 3,
      "texto": "En la playa con chancleta' Christian Diore'",
      "clave": "diore",
      "inicio": 5.8,
      "fin": 8.12
    },
    {
      "n": 4,
      "texto": "Traje dos tussi pa' las puta' de diferente' colore'",
      "clave": "tussi",
      "inicio": 8.28,
      "fin": 11.16
    },
    {
      "n": 5,
      "texto": "Tengo $4 millone' en reloje'",
      "clave": "millone",
      "inicio": 11.36,
      "fin": 13.249
    },
    {
      "n": 6,
      "texto": "Richard Mille, Patek Phillipe, AP, Cartier, Jacob y Rolex",
      "clave": "rolex",
      "inicio": 13.92,
      "fin": 16.66
    },
    {
      "n": 7,
      "texto": "Yo me puse un Lamborghini en la muñeca",
      "clave": "lamborghini",
      "inicio": 16.713,
      "fin": 18.76
    },
    {
      "n": 8,
      "texto": "Si arma'o me paran, que me mamen el bicho, soy cuatro letra'",
      "clave": "letra",
      "inicio": 19.2,
      "fin": 22.18
    },
    {
      "n": 9,
      "texto": "Trabajo con la empresa, pa' que sepan",
      "clave": "empresa",
      "inicio": 22.48,
      "fin": 24.28
    },
    {
      "n": 10,
      "texto": "Toma esta feria, buen día, y piso la Urus a 200",
      "clave": "feria",
      "inicio": 24.68,
      "fin": 27.68
    },
    {
      "n": 11,
      "texto": "Rameada oro amarillo la glopeta",
      "clave": "glopeta",
      "inicio": 27.74,
      "fin": 29.9
    },
    {
      "n": 12,
      "texto": "Te grabamo' y te picamo' como el Cartel de Los Zeta'",
      "clave": "zeta",
      "inicio": 30.28,
      "fin": 33.343
    }
  ],
