{
 "firma": "cancion",
 "duracion": 35.1,
 "frases": [
  {
   "n": 1,
   "texto": "Otra ve', otro día, otra noche en Miami",
   "clave": "miami",
   "inicio": 0.84,
   "fin": 3.38
  },
  {
   "n": 2,
   "texto": "Máscara negra, ropa negra, gafas negra', mami",
   "clave": "mascara",
   "inicio": 3.48,
   "fin": 6.16
  },
  {
   "n": 3,
   "texto": "Me fui sin prenda', sin decirle na' a la doña",
   "clave": "prenda",
   "inicio": 6.244,
   "fin": 8.54
  },
  {
   "n": 4,
   "texto": "Y ahora maquinando en el carro dejo una moña",
   "clave": "carro",
   "inicio": 8.58,
   "fin": 11.16
  },
  {
   "n": 5,
   "texto": "Así es la vida, cuando meno' estás fallando",
   "clave": "vida",
   "inicio": 11.46,
   "fin": 13.7
  },
  {
   "n": 6,
   "texto": "Es que tu pareja piensa que estás traicionando",
   "clave": "traicionando",
   "inicio": 13.84,
   "fin": 16.16
  },
  {
   "n": 7,
   "texto": "No es mentira, contigo me siento cabrón",
   "clave": "cabron",
   "inicio": 16.5,
   "fin": 18.5
  },
  {
   "n": 8,
   "texto": "Pero a vece' jodiendo no dejas ni enrolar un blunt",
   "clave": "blunt",
   "inicio": 18.6,
   "fin": 21.06
  },
  {
   "n": 9,
   "texto": "Y me dice: \"Hijueputa, tú lo que ere' e' un cabrón",
   "clave": "hijueputa",
   "inicio": 21.1,
   "fin": 23.52
  },
  {
   "n": 10,
   "texto": "Tú me tiene' aborrecía', tú me tiene' en depresión\"",
   "clave": "depresion",
   "inicio": 23.6,
   "fin": 25.92
  },
  {
   "n": 11,
   "texto": "Y yo le digo que el tiempo a mí me va a dar to'a la razón",
   "clave": "tiempo",
   "inicio": 26.02,
   "fin": 28.44
  },
  {
   "n": 12,
   "texto": "Cuando yo me case contigo y te regale una mansión",
   "clave": "mansion",
   "inicio": 28.48,
   "fin": 31.08
  },
  {
   "n": 13,
   "texto": "Y te dé uno' par de día' y otro carro más cabrón",
   "clave": "carro",
   "inicio": 31.18,
   "fin": 33.62
  },
  {
   "n": 14,
   "texto": "Ahora tiene' lo que viste un…",
   "clave": "viste",
   "inicio": 33.66,
   "fin": 35.1
  }
 ],
