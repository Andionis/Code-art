{
 "firma": "cancion",
 "duracion": 38.2,
 "frases": [
  {
   "n": 1,
   "texto": "'Toy haciendo justamente to' lo que no debo",
   "clave": "debo",
   "inicio": 0.64,
   "fin": 3.9
  },
  {
   "n": 2,
   "texto": "La botella dice \"peligro\", pero igual la bebo",
   "clave": "peligro",
   "inicio": 5.48,
   "fin": 8.92
  },
  {
   "n": 3,
   "texto": "La comida tiene veneno, pero igual la pruebo",
   "clave": "veneno",
   "inicio": 10.54,
   "fin": 13.88
  },
  {
   "n": 4,
   "texto": "Que me iba a enredar, lo sé, lo supe desde el inicio",
   "clave": "enredar",
   "inicio": 16.64,
   "fin": 21.72
  },
  {
   "n": 5,
   "texto": "Te probé por curioso y terminaste siendo un vicio",
   "clave": "vicio",
   "inicio": 22.08,
   "fin": 26.76
  },
  {
   "n": 6,
   "texto": "Me diste alas para volar en tu precipicio",
   "clave": "alas",
   "inicio": 26.84,
   "fin": 31.66
  },
  {
   "n": 7,
   "texto": "Pero lo vuelvo a hacer sin importar el sacrificio",
   "clave": "sacrificio",
   "inicio": 32.18,
   "fin": 36.88
  }
 ],
