{
  "firma": "cancion",
  "duracion": 35.3,
  "frases": [
    {
      "n": 1,
      "texto": "Me desespero cuando no contesta', me está matando esta ansiedad",
      "clave": "desespero",
      "inicio": 0.06,
      "fin": 4.62
    },
    {
      "n": 2,
      "texto": "Me pregunto cómo estás, qué haces y dónde estás",
      "clave": "pregunto",
      "inicio": 4.82,
      "fin": 9.22
    },
    {
      "n": 3,
      "texto": "El tiempo corriendo sin ti, el mundo no para de girar",
      "clave": "tiempo",
      "inicio": 9.58,
      "fin": 13.62
    },
    {
      "n": 4,
      "texto": "Toa' estas putas me hacen venir, pero no me dan felicidad",
      "clave": "felicidad",
      "inicio": 13.86,
      "fin": 18
    },
    {
      "n": 5,
      "texto": "En el pasado me estanco",
      "clave": "estanco",
      "inicio": 18.008,
      "fin": 19.38
    },
    {
      "n": 6,
      "texto": "Pa' despejar la mente voy con mi rifle a tirar al blanco",
      "clave": "rifle",
      "inicio": 19.88,
      "fin": 23.8
    },
    {
      "n": 7,
      "texto": "No entiende', yo siempre paso la página, y otras vece' la arranco",
      "clave": "pagina",
      "inicio": 24.16,
      "fin": 28.46
    },
    {
      "n": 8,
      "texto": "Esta vez se me fue la guagua y me quedé senta'o en el banco",
      "clave": "guagua",
      "inicio": 28.66,
      "fin": 33
    },
    {
      "n": 9,
      "texto": "Titanic, se me hundió el barco",
      "clave": "titanic",
      "inicio": 33.26,
      "fin": 35.3
    }
  ],
