{
  "firma": "cancion",
  "duracion": 30,
  "frases": [
    {
      "n": 1,
      "texto": "Tú no te va' a arrepentir de haberme conocido",
      "clave": "arrepentir",
      "inicio": 0.74,
      "fin": 3.4
    },
    {
      "n": 2,
      "texto": "Encima mío a cada rato te imagino",
      "clave": "imagino",
      "inicio": 3.68,
      "fin": 5.62
    },
    {
      "n": 3,
      "texto": "Es que tú sabe' que contigo compagino",
      "clave": "compagino",
      "inicio": 5.96,
      "fin": 7.88
    },
    {
      "n": 4,
      "texto": "¿Por qué tú cree' que sin pensar nos elegimo'?",
      "clave": "elegimo",
      "inicio": 8.24,
      "fin": 10.195
    },
    {
      "n": 5,
      "texto": "Y yo no olvido na' de lo que nos dijimo'",
      "clave": "olvido",
      "inicio": 10.6,
      "fin": 13.003
    },
    {
      "n": 6,
      "texto": "Vamo' a lo que vinimo'",
      "clave": "vinimo",
      "inicio": 13.58,
      "fin": 14.903
    },
    {
      "n": 7,
      "texto": "En el deportivo la toqué y ella se vino",
      "clave": "deportivo",
      "inicio": 15.079,
      "fin": 17.28
    },
    {
      "n": 8,
      "texto": "El tiempo no perdimo'",
      "clave": "tiempo",
      "inicio": 17.7,
      "fin": 18.935
    },
    {
      "n": 9,
      "texto": "Tú no te va' a arrepentir de haberme conocido",
      "clave": "arrepentir",
      "inicio": 19.26,
      "fin": 21.84
    },
    {
      "n": 10,
      "texto": "Encima mío a cada rato te imagino",
      "clave": "imagino",
      "inicio": 22.12,
      "fin": 24.16
    },
    {
      "n": 11,
      "texto": "Es que tú sabe' que contigo compagino",
      "clave": "compagino",
      "inicio": 24.42,
      "fin": 26.36
    },
    {
      "n": 12,
      "texto": "¿Por qué tú crees que sin pensar nos elegimo'?",
      "clave": "elegimo",
      "inicio": 26.7,
      "fin": 28.603
    }
  ],
